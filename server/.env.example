# MongoDB Atlas connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=
# Database name inside the cluster (created automatically on first write)
MONGODB_DB=smartsupport

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIMENSION=768

# Pinecone API key (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=
# Index name. If it doesn't exist, the Phase 1 seed script creates it
# (serverless, aws us-east-1, cosine, dimension 768).
PINECONE_INDEX=smartsupport
# Optional: pin the index host URL directly
# PINECONE_HOST=

# API port (5001 by default; 5000 collides with AirPlay on macOS)
# PORT=5001
