# MongoDB connection string.
#  - On your own machine: use your Atlas URI (Atlas: Database > Connect > Drivers), e.g.
#    mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=app
#  - In the Claude cloud container Atlas is unreachable (raw TCP egress is blocked),
#    so a local FerretDB (MongoDB-compatible) runs instead: npm run db:local
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name inside the cluster (created automatically on first write)
MONGODB_DB=smartsupport

# OpenRouter API key (https://openrouter.ai/keys) — used for classification,
# reply drafting, and summarization.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Pinecone API key (https://app.pinecone.io -> API Keys) — used for both vector
# storage AND embeddings (Pinecone Inference hosted model; OpenRouter has no
# embeddings endpoint).
PINECONE_API_KEY=
# Index name. If it doesn't exist, the Phase 1 seed script creates it
# (serverless, aws us-east-1, cosine, dimension 1024 to match llama-text-embed-v2).
PINECONE_INDEX=smartsupport
# Optional: pin the index host URL directly
# PINECONE_HOST=
# EMBED_MODEL=llama-text-embed-v2
# EMBED_DIMENSION=1024

# API port (5001 by default; 5000 collides with AirPlay on macOS)
# PORT=5001
